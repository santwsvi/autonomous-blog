# === Database ===
DATABASE_URL=postgresql+asyncpg://blog:blog@localhost:5432/blog

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Auth ===
JWT_SECRET_KEY=change-me-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@blog.com
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'changeme', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# === CORS ===
FRONTEND_URL=http://localhost:3000

# === Webhook ===
REVALIDATION_SECRET=change-me-min-32-chars

# === LLM ===
OPENAI_API_KEY=
# Set to false to disable SSL verification (corporate proxy / Zscaler)
LLM_SSL_VERIFY=true

# === App ===
LOG_LEVEL=INFO
DEBUG=true
